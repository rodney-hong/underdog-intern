# Copy to backend/.env and fill in. Never commit .env.

# --- Run mode (cloud migration plan v2) ------------------------------------------
# prod: this machine collects (pulls, sync, ETL, loggers, pollers, backups). Only ONE machine.
# dry:  nothing runs; every job prod would run is logged with its ET time.
# dev:  (default) nothing automatic; the API serves the app; scripts run by hand.
SPORTSBETTR_MODE=dev
# 1 turns on the WNBA routes, the startup WNBA data load and WNBA training
WNBA_ENABLED=0

# --- Admin login: set both with `python auth.py set-password` (never by hand) -----
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Host headers the API accepts; /docs, /redoc, /openapi.json only with API_DOCS_ENABLED=1
ALLOWED_HOSTS=bettr.rodneyhong.com,localhost,127.0.0.1
API_DOCS_ENABLED=0

# --- API keys -------------------------------------------------------------------
ODDS_API_KEY=
ODDS_API_HISTORICAL_KEY=
BALLDONTLIE_WNBA_KEY=
TYPESAFE_API_KEY=
# only for SCREENSHOT_EXTRACTOR=claude
ANTHROPIC_API_KEY=

# --- OddsAPI budget and line logger ---------------------------------------------
ODDS_MONTHLY_CREDIT_CAP=500
LINE_LOGGER_ENABLED=1
LINE_LOG_OPEN_PULL_ENABLED=1
LINE_LOG_OPEN_HOUR_ET=10
LINE_LOG_SCHEDULE_HOUR_ET=6
LINE_LOG_PRETIP_MINUTES=30
PAPER_PREDICTIONS_ENABLED=1
NEWS_INGEST_ENABLED=1

# --- Kaggle ----------------------------------------------------------------------
# Download cache (kagglehub's setting; default ~/.cache/kagglehub). Versions older than the
# one loaded are deleted after each successful ETL. Leave commented out for the default; an
# empty value would make kagglehub use the working directory.
# KAGGLEHUB_CACHE=/home/sportsbettr/.cache/kagglehub

# --- Screenshot import ------------------------------------------------------------
# ollama: local vision model, cards cropped and each read twice. claude: Claude API.
SCREENSHOT_EXTRACTOR=ollama
SCREENSHOT_OLLAMA_MODEL=gemma4:12b
# concurrent card reads; 6 was fastest on an RTX 5070 Ti
SCREENSHOT_OLLAMA_PARALLEL=6
OLLAMA_URL=http://localhost:11434
SCREENSHOT_CLAUDE_MODEL=claude-opus-5-5
